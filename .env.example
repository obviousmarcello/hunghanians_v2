# ---- Server ----
PORT=3000
# Set to 1 when running behind a reverse proxy / PaaS (Render, Fly, Railway, nginx) so rate limiting sees real client IPs.
TRUST_PROXY=0
# Comma-separated list of extra origins allowed to call the API (only needed if the frontend is hosted
# somewhere else, e.g. GitHub Pages). Same-origin requests always work.
CORS_ORIGINS=
# Where registrations are stored (JSON Lines file).
DATA_DIR=./data

# ---- Email ----
# "smtp" sends real mail. "log" prints emails to the console instead (handy for local development).
MAIL_TRANSPORT=log
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true for port 465, false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Hunghanians <hello@example.com>"
# Who receives contact messages and new-registration notifications (comma-separated).
ORGANISER_EMAIL=organisers@example.com

# ---- Payment details included in registration confirmation emails ----
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=

# ---- Admin ----
# Long random string. Used as a Bearer token for GET /api/admin/registrations.csv
ADMIN_TOKEN=
